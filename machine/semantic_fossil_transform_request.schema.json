    },
    "route_id": {
      "type": "string"
    },
    "medium": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "active_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "causal_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "fossil_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
