{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/merrypranxter/ai_slop/machine/experiment.schema.json",
  "title": "AI SLOP Experiment Run",
  "type": "object",
  "required": ["run_id", "media", "model_or_tool", "operator_ids", "epistemic_status_before", "assumption_attacked", "procedure", "observed_result"],
  "properties": {
    "run_id": {"type":"string"},
    "date": {"type":["string","null"]},
    "researcher": {"type":["string","null"]},
    "media": {"enum":["image","video","audio","text","controller","mixed"]},
    "model_or_tool": {"type":"string"},
    "model_version": {"type":["string","null"]},
    "operator_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "epistemic_status_before": {"enum":["OBSERVED","SUPPORTED","HYPOTHESIS","PROCEDURAL","METAPHOR","SPECULATIVE","ARCHIVED","SUPERSEDED"]},
    "input_or_seed_material": {},
    "seed_or_randomness": {},
    "reference_assets": {"type":"array","items":{}},
    "assumption_attacked": {"type":"string"},
    "mechanism_claim": {"type":["string","null"]},
    "competing_conditions": {"type":"array","items":{"type":"string"}},
    "invariant_or_anchor": {"type":["string","null"]},
    "procedure": {"type":"string"},
    "baseline": {},
    "control": {},
    "ablation": {},
    "independent_variable": {"type":["string","null"]},
    "dose_or_strength": {},
    "iteration_or_cycle": {},
    "operation_order": {"type":"array","items":{"type":"string"}},
    "expected_artifact_family": {"type":["string","null"]},
    "condition_dropout_risk": {"type":["string","null"]},
    "known_confounds": {"type":"array","items":{"type":"string"}},
    "observed_result": {"type":"string"},
    "artifact_coordinates_or_timestamps": {},
    "persistence_after_cause_removed": {"type":["boolean","null"]},
    "route_or_history_effect": {"type":["string","null"]},
    "creative_utility": {"type":["number","null"]},
    "mechanism_confidence": {"type":["number","null"]},
    "next_test": {"type":["string","null"]},
    "notes": {"type":["string","null"]}
  },
  "additionalProperties": true
}
